[
  {
    "context": "Workspace",
    "bindings": {}
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {}
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-left": "pane::GoBack"
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-right": "pane::GoForward"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-l": "editor::SelectLine"
    }
  }
]
